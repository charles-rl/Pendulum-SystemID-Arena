<mujoco model="single link pendulum">
	<compiler inertiafromgeom="true" angle="radian"/>
	<default>
		<geom contype="0" friction="1 0.1 0.1" rgba="0.7 0.7 0 1"/>
		<default class="STS3215">
			<joint damping="0.60" frictionloss="0.052" armature="0.028"/>
			<position kp="998.22" kv="2.731" forcerange="-2.94 2.94"/>
		</default>
		<default class="backlash">
			<!-- +/- 0.87° of backlash -->
			<joint damping="0.01" frictionloss="0" armature="0.01" limited="true" range="-0.015184364492350668 0.015184364492350668"/>
		</default>
	</default>
	<option gravity="0 0 -9.80665" integrator="RK4" timestep="0.001"/>

	<worldbody>
        <body name="pole" pos="0 0 0">
			<!-- Motor joint (actuated) -->
			<joint name="motor" class="STS3215" axis="0 1 0" pos="0 0 0" limited="false" type="hinge"/>
			<!-- Backlash joint (limited free play) -->
			<joint name="backlash_joint" class="backlash" axis="0 1 0" pos="0 0 0" type="hinge"/>
			<!-- Assuming a 200mm pole, 20mm radius, and 1270 kg/m^3 density (PETG) -->
            <geom fromto="0 0 0 0.001 0 0.2" name="cpole" rgba="0 0.7 0.7 1" size="0.02 0.1" density="1270" type="capsule"/>
        </body>
	</worldbody>

	<actuator>
		<position class="STS3215" joint="motor" forcerange="-3.35 3.35" ctrlrange="-3.14159 3.14159"/>
	</actuator>
</mujoco>
